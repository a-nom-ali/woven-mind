{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/mcml.schema.json",
  "title": "Model Context Markup Language (MCML)",
  "description": "A schema for configuring AI agents, including tools, workflows, conversations, and events. Supports MCP, A2A, and advanced workflow features.",
  "version": "1.2",
  "type": "object",
  "properties": {
    "mcml": {
      "$ref": "#/definitions/Mcml",
      "description": "Root element of the MCML document."
    },
    "text": {
      "type": "string",
      "description": "Input text for the model."
    },
    "image": {
      "type": "string",
      "format": "uri",
      "description": "URI to an image file or Base64 encoded image data."
    },
    "audio": {
      "type": "string",
      "format": "uri",
      "description": "URI to an audio file or Base64 encoded audio data."
    }
  },
  "required": ["mcml"],
  "definitions": {
    "Mcml": {
      "type": "object",
      "description": "Root element for MCML documents.",
      "properties": {
        "head": {
          "$ref": "#/definitions/HeadType",
          "description": "Metadata about the model, including capabilities, constraints, and tools."
        },
        "body": {
          "$ref": "#/definitions/BodyType",
          "description": "Main content, including flows, conversations, and events."
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportType"
          },
          "description": "External MCML documents to import.",
          "minItems": 0
        },
        "version": {
          "type": "string",
          "description": "Version of the MCML schema used.",
          "pattern": "^\\d+\\.\\d+$"
        },
        "baseAgent": {
          "type": "string",
          "description": "Identifier for the base agent or model."
        },
        "protocolVersions": {
          "type": "object",
          "properties": {
            "MCP": {
              "type": "string",
              "description": "Version of MCP used."
            },
            "A2A": {
              "type": "string",
              "description": "Version of A2A used."
            }
          },
          "description": "Versions of protocols used in this MCML document."
        }
      },
      "required": ["head", "body", "version"]
    },
    "ImportType": {
      "type": "object",
      "description": "Imports an external MCML document.",
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "format": "uri",
          "description": "URI of the MCML document to import."
        }
      }
    },
    "HeadType": {
      "type": "object",
      "description": "Metadata about the model, including capabilities, constraints, and tools.",
      "properties": {
        "identity": {
          "type": "string",
          "description": "Unique identifier for the model."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of model capabilities (e.g., 'summarization', 'translation').",
          "minItems": 0
        },
        "constraints": {
          "type": "string",
          "description": "Constraints on the model's behavior (e.g., 'no profanity')."
        },
        "style": {
          "type": "string",
          "description": "Desired style of the model's output (e.g., 'formal', 'informal')."
        },
        "memory": {
          "type": "integer",
          "description": "Size of the model's memory (in tokens).",
          "minimum": 0
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Goals for the model to achieve.",
          "minItems": 0
        },
        "tools": {
          "$ref": "#/definitions/ToolsType",
          "description": "Tools available to the model, including MCP-based tools."
        },
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "Named schema definitions for tool inputs/outputs (e.g., JSON Schema)."
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportType"
          },
          "description": "External MCML documents to import for the head section.",
          "minItems": 0
        }
      },
      "required": ["identity"]
    },
    "ToolsType": {
      "type": "object",
      "description": "Defines the available tools that the model can use.",
      "properties": {
        "tool": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolsType.Tool"
          },
          "minItems": 0
        }
      }
    },
    "ToolsType.Tool": {
      "type": "object",
      "description": "A tool the model can invoke, supporting various protocols like MCP.",
      "required": ["name", "connection", "inputSchema", "outputSchema"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique name of the tool."
        },
        "connection": {
          "type": "object",
          "description": "How to connect to the tool.",
          "properties": {
            "protocol": {
              "type": "string",
              "enum": ["MCP", "local", "API", "custom"],
              "description": "Protocol for accessing the tool."
            },
            "details": {
              "type": "object",
              "description": "Protocol-specific connection details.",
              "properties": {
                "auth": {
                  "type": "object",
                  "description": "Authentication details.",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["apiKey", "oauth", "none"],
                      "description": "Type of authentication."
                    },
                    "credentials": {
                      "type": "object",
                      "description": "Authentication credentials.",
                      "additionalProperties": true
                    }
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "required": ["protocol"]
        },
        "inputSchema": {
          "oneOf": [
            {"type": "object"},
            {"type": "string", "description": "Reference to a named schema in head.schemas"}
          ],
          "description": "Input parameters for the tool."
        },
        "outputSchema": {
          "oneOf": [
            {"type": "object"},
            {"type": "string", "description": "Reference to a named schema in head.schemas"}
          ],
          "description": "Expected output format of the tool."
        },
        "requiresConsent": {
          "type": "boolean",
          "description": "Whether user consent is required to use this tool.",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the tool."
        }
      }
    },
    "FlowType.Step": {
      "type": "object",
      "description": "A step in a flow, which can be a control structure or an action.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["if", "loop", "parallel", "sequence", "action"],
          "description": "Type of the step."
        },
        "condition": {
          "type": "string",
          "description": "Condition for 'if' or 'loop' steps."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowType.Step"
          },
          "description": "Nested steps for 'sequence', 'parallel', or 'loop'."
        },
        "action": {
          "$ref": "#/definitions/FlowType.Action",
          "description": "Action to perform for 'action' steps."
        },
        "onError": {
          "$ref": "#/definitions/FlowType.ErrorHandler",
          "description": "Error handling for this step."
        }
      },
      "required": ["type"]
    },
    "FlowType.Action": {
      "type": "object",
      "description": "An action within a flow step.",
      "properties": {
        "useTool": {
          "$ref": "#/definitions/FlowType.Action.UseTool",
          "description": "Use a specific tool."
        },
        "agent": {
          "$ref": "#/definitions/AgentResponse",
          "description": "Response to the user."
        },
        "communicate": {
          "$ref": "#/definitions/FlowType.Action.Communicate",
          "description": "Communicate with another agent."
        }
      },
      "oneOf": [
        {"required": ["useTool"]},
        {"required": ["agent"]},
        {"required": ["communicate"]}
      ]
    },
    "FlowType.Action.UseTool": {
      "type": "object",
      "description": "Use a tool within a flow.",
      "required": ["name", "parameters"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the tool to use."
        },
        "parameters": {
          "type": "object",
          "description": "Input parameters for the tool, supporting dynamic expressions."
        },
        "resultVariable": {
          "type": "string",
          "description": "Variable to store the tool's result."
        }
      }
    },
    "FlowType.Action.Communicate": {
      "type": "object",
      "description": "Send a message to another agent.",
      "properties": {
        "protocol": {
          "type": "string",
          "default": "A2A",
          "description": "Communication protocol."
        },
        "target": {
          "type": "string",
          "description": "Identifier of the target agent."
        },
        "message": {
          "type": "object",
          "description": "Message content.",
          "additionalProperties": true
        }
      },
      "required": ["target", "message"]
    },
    "FlowType.ErrorHandler": {
      "type": "object",
      "description": "Defines error handling for a flow step.",
      "properties": {
        "retry": {
          "type": "integer",
          "description": "Number of times to retry the step."
        },
        "fallback": {
          "$ref": "#/definitions/FlowType.Step",
          "description": "Fallback step to execute on error."
        },
        "log": {
          "type": "string",
          "description": "Log message or action."
        }
      }
    },
    "FlowType": {
      "type": "object",
      "description": "Defines a workflow or process.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the flow."
        },
        "name": {
          "type": "string",
          "description": "Name of the flow."
        },
        "description": {
          "type": "string",
          "description": "Description of the flow."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowType.Step"
          },
          "description": "Steps in the flow.",
          "minItems": 0
        },
        "context": {
          "type": "object",
          "description": "Initial context for the flow.",
          "additionalProperties": true
        }
      },
      "required": ["id", "steps"]
    },
    "AgentResponse": {
      "type": "object",
      "description": "Rich response from the agent.",
      "properties": {
        "text": {
          "type": "string",
          "description": "Textual response."
        },
        "format": {
          "type": "string",
          "enum": ["plain", "markdown", "html"],
          "description": "Format of the text."
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["image", "audio", "file"]
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "description": "Attachments to the response."
        }
      },
      "required": ["text"]
    },
    "ConversationType.Turn": {
      "type": "object",
      "description": "A single turn in a conversation.",
      "required": ["user", "agent"],
      "properties": {
        "user": {
          "type": "string",
          "description": "User’s input."
        },
        "agent": {
          "$ref": "#/definitions/AgentResponse",
          "description": "Agent’s response."
        },
        "useTool": {
          "$ref": "#/definitions/FlowType.Action.UseTool",
          "description": "Tool used during this turn."
        },
        "communicated": {
          "$ref": "#/definitions/FlowType.Action.Communicate",
          "description": "Agent-to-agent communication during this turn."
        }
      }
    },
    "ConversationType": {
      "type": "object",
      "description": "Represents a multi-turn conversation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the conversation."
        },
        "turn": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConversationType.Turn"
          },
          "description": "List of turns in the conversation.",
          "minItems": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the conversation's start."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags associated with the conversation.",
          "minItems": 0
        }
      },
      "required": ["id"]
    },
    "EventsType.OnReceive.Then": {
      "type": "object",
      "description": "Action to take when an event is received.",
      "properties": {
        "agent": {
          "$ref": "#/definitions/AgentResponse",
          "description": "Response to send."
        },
        "useTool": {
          "$ref": "#/definitions/FlowType.Action.UseTool",
          "description": "Use a specific tool."
        },
        "communicate": {
          "$ref": "#/definitions/FlowType.Action.Communicate",
          "description": "Communicate with another agent."
        }
      },
      "oneOf": [
        {"required": ["agent"]},
        {"required": ["useTool"]},
        {"required": ["communicate"]}
      ]
    },
    "EventsType.OnReceive": {
      "type": "object",
      "description": "Defines an event to listen for.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user.message", "agent.message", "system.error", "custom"],
          "description": "Type of event."
        },
        "source": {
          "type": "string",
          "description": "Source of the event."
        },
        "payloadSchema": {
          "type": "object",
          "description": "Schema for the event payload."
        },
        "then": {
          "$ref": "#/definitions/EventsType.OnReceive.Then",
          "description": "Action to take when the event is received."
        }
      }
    },
    "EventsType": {
      "type": "object",
      "description": "Defines a set of events to listen for.",
      "properties": {
        "onReceive": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EventsType.OnReceive"
          },
          "description": "List of events to listen for.",
          "minItems": 0
        }
      }
    },
    "BodyType": {
      "type": "object",
      "description": "Contains the main content of the MCML document.",
      "properties": {
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowType"
          },
          "description": "List of workflows.",
          "minItems": 0
        },
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConversationType"
          },
          "description": "List of conversations.",
          "minItems": 0
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EventsType"
          },
          "description": "List of events.",
          "minItems": 0
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportType"
          },
          "description": "External MCML documents to import for the body section.",
          "minItems": 0
        }
      }
    }
  }
}
