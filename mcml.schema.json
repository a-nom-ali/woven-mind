{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/mcml.schema.json",
  "title": "Model Context Markup Language (MCML)",
  "description": "A schema for configuring AI agents, including tools, workflows, conversations, and events. Supports MCP and A2A protocols.",
  "version": "1.2",
  "type": "object",
  "properties": {
    "mcml": {
      "$ref": "#/definitions/Mcml",
      "description": "Root element of the MCML document."
    },
    "text": {
      "type": "string",
      "description": "Input text for the model."
    },
    "image": {
      "type": "string",
      "format": "uri",
      "description": "URI to an image file or Base64 encoded image data."
    },
    "audio": {
      "type": "string",
      "format": "uri",
      "description": "URI to an audio file or Base64 encoded audio data."
    }
  },
  "required": ["mcml"],
  "definitions": {
    "Mcml": {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "#/definitions/HeadType",
          "description": "Metadata about the model, including capabilities, constraints, and tools."
        },
        "body": {
          "$ref": "#/definitions/BodyType",
          "description": "Main content, including flows, conversations, and events."
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImportType"
          },
          "description": "External MCML documents to import.",
          "minItems": 0
        },
        "version": {
          "type": "string",
          "description": "Version of the MCML schema used.",
          "pattern": "^\\d+\\.\\d+$"
        },
        "baseAgent": {
          "type": "string",
          "description": "Identifier for the base agent or model."
        },
        "protocolVersions": {
          "type": "object",
          "properties": {
            "MCP": { "type": "string" },
            "A2A": { "type": "string" }
          },
          "description": "Versions of protocols used in this MCML document."
        },
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "description": "Named schema definitions for tools and events."
        }
      },
      "required": ["head", "body", "version"]
    },
    "ImportType": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "format": "uri",
          "description": "URI of the MCML document to import."
        }
      },
      "required": ["file"]
    },
    "HeadType": {
      "type": "object",
      "properties": {
        "identity": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "string" },
        "style": { "type": "string" },
        "memory": { "type": "integer", "minimum": 0 },
        "goals": { "type": "array", "items": { "type": "string" } },
        "tools": { "$ref": "#/definitions/ToolsType" },
        "imports": { "type": "array", "items": { "$ref": "#/definitions/ImportType" } }
      },
      "required": ["identity"]
    },
    "ToolsType": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "array",
          "items": { "$ref": "#/definitions/ToolsType.Tool" }
        }
      }
    },
    "ToolsType.Tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "connection": {
          "type": "object",
          "properties": {
            "protocol": { "type": "string", "enum": ["MCP", "local", "API", "custom"] },
            "details": {
              "type": "object",
              "properties": {
                "auth": { "$ref": "#/definitions/AuthType" }
              },
              "additionalProperties": true
            }
          },
          "required": ["protocol"]
        },
        "inputSchema": { "$ref": "#/definitions/SchemaOrReference" },
        "outputSchema": { "$ref": "#/definitions/SchemaOrReference" },
        "requiresConsent": { "type": "boolean", "default": false },
        "description": { "type": "string" }
      },
      "required": ["name", "connection", "inputSchema", "outputSchema"]
    },
    "SchemaOrReference": {
      "oneOf": [
        { "type": "object", "description": "Inline schema definition." },
        { "type": "string", "pattern": "^\\$schemas\\.[a-zA-Z0-9_]+$", "description": "Reference to a schema in the schemas section." }
      ]
    },
    "AuthType": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["none", "apiKey", "oauth", "basic"], "default": "none" },
        "credentials": { "type": "object", "additionalProperties": true }
      },
      "required": ["type"]
    },
    "FlowType": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "context": { "type": "object", "additionalProperties": true },
        "steps": { "type": "array", "items": { "$ref": "#/definitions/FlowStep" } }
      },
      "required": ["id", "steps"]
    },
    "FlowStep": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["if", "loop", "parallel", "sequence", "action"] },
        "onError": { "$ref": "#/definitions/OnError" }
      },
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "if" },
            "condition": { "type": "string" },
            "then": { "type": "array", "items": { "$ref": "#/definitions/FlowStep" } },
            "else": { "type": "array", "items": { "$ref": "#/definitions/FlowStep" } }
          },
          "required": ["condition", "then"]
        },
        {
          "properties": {
            "type": { "const": "loop" },
            "condition": { "type": "string" },
            "maxIterations": { "type": "integer", "minimum": 1 },
            "steps": { "type": "array", "items": { "$ref": "#/definitions/FlowStep" } }
          },
          "required": ["condition", "steps"]
        },
        {
          "properties": {
            "type": { "const": "parallel" },
            "steps": { "type": "array", "items": { "$ref": "#/definitions/FlowStep" } },
            "resultsVariable": { "type": "string" },
            "onError": { "$ref": "#/definitions/OnError" }
          },
          "required": ["steps"]
        },
        {
          "properties": {
            "type": { "const": "sequence" },
            "steps": { "type": "array", "items": { "$ref": "#/definitions/FlowStep" } }
          },
          "required": ["steps"]
        },
        {
          "properties": {
            "type": { "const": "action" },
            "action": { "$ref": "#/definitions/ActionType" }
          },
          "required": ["action"]
        }
      ]
    },
    "ActionType": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "useTool": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "parameters": { "type": "object", "additionalProperties": true },
                "resultVariable": { "type": "string" }
              },
              "required": ["name", "parameters"]
            }
          },
          "required": ["useTool"]
        },
        {
          "properties": {
            "agent": { "$ref": "#/definitions/AgentResponse" }
          },
          "required": ["agent"]
        },
        {
          "properties": {
            "communicate": {
              "type": "object",
              "properties": {
                "protocol": { "type": "string", "default": "A2A" },
                "target": { "type": "string" },
                "message": { "type": "object", "additionalProperties": true }
              },
              "required": ["target", "message"]
            }
          },
          "required": ["communicate"]
        }
      ]
    },
    "AgentResponse": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "format": { "type": "string", "enum": ["plain", "markdown", "html"], "default": "plain" },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["image", "file", "audio", "video"] },
              "url": { "type": "string", "format": "uri" },
              "description": { "type": "string" }
            },
            "required": ["type", "url"]
          }
        }
      },
      "required": ["text"]
    },
    "OnError": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["retry", "fallback", "log", "ignore"] },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "delay": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/definitions/ActionType" },
        "message": { "type": "string" }
      },
      "required": ["type"]
    },
    "ConversationType": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "turn": { "type": "array", "items": { "$ref": "#/definitions/ConversationType.Turn" } },
        "timestamp": { "type": "string", "format": "date-time" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id"]
    },
    "ConversationType.Turn": {
      "type": "object",
      "properties": {
        "user": { "type": "string" },
        "agent": { "$ref": "#/definitions/AgentResponse" },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/ActionType" } }
      },
      "required": ["user", "agent"]
    },
    "EventsType": {
      "type": "object",
      "properties": {
        "onReceive": { "type": "array", "items": { "$ref": "#/definitions/EventsType.OnReceive" } }
      }
    },
    "EventsType.OnReceive": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["user.message", "agent.message", "system.error", "custom"] },
        "customType": { "type": "string" },
        "source": { "type": "string" },
        "payloadSchema": { "$ref": "#/definitions/SchemaOrReference" },
        "then": { "$ref": "#/definitions/ActionType" }
      },
      "required": ["type", "then"]
    },
    "BodyType": {
      "type": "object",
      "properties": {
        "flows": { "type": "array", "items": { "$ref": "#/definitions/FlowType" } },
        "conversations": { "type": "array", "items": { "$ref": "#/definitions/ConversationType" } },
        "events": { "type": "array", "items": { "$ref": "#/definitions/EventsType" } },
        "imports": { "type": "array", "items": { "$ref": "#/definitions/ImportType" } }
      }
    }
  }
}
